{
  "_comment": "Шаблон inbound VLESS + Reality + XTLS-Vision. Плейсхолдеры {{...}} подставляет scripts/install-node.sh",
  "tag": "VLESS_REALITY_{{NODE_CODE}}",
  "listen": "0.0.0.0",
  "port": {{PORT}},
  "protocol": "vless",
  "settings": {
    "clients": [],
    "decryption": "none"
  },
  "streamSettings": {
    "network": "tcp",
    "security": "reality",
    "realitySettings": {
      "show": false,
      "dest": "{{SNI}}:443",
      "xver": 0,
      "serverNames": ["{{SNI}}"],
      "privateKey": "{{REALITY_PRIVATE_KEY}}",
      "shortIds": ["{{SHORT_ID}}"]
    }
  },
  "sniffing": {
    "enabled": true,
    "destOverride": ["http", "tls", "quic"]
  }
}
