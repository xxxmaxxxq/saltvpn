{
  "_comment": "Конфиг Xray для панели Marzban. Плейсхолдеры {{...}} подставляет scripts/deploy-master.sh",
  "log": {
    "loglevel": "warning",
    "access": "none",
    "error": ""
  },
  "inbounds": [
    {
      "tag": "VLESS_REALITY_{{NODE_CODE}}",
      "listen": "0.0.0.0",
      "port": {{PORT}},
      "protocol": "vless",
      "settings": {
        "clients": [],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "{{SNI}}:443",
          "xver": 0,
          "serverNames": ["{{SNI}}"],
          "privateKey": "{{PRIVATE_KEY}}",
          "shortIds": ["{{SHORT_ID}}"]
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"]
      }
    }
  ],
  "outbounds": [
    {
      "tag": "DIRECT",
      "protocol": "freedom",
      "settings": { "domainStrategy": "UseIPv4" }
    },
    {
      "tag": "BLOCK",
      "protocol": "blackhole",
      "settings": {}
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "_comment": "Приватные сети: защита от доступа к локальной сети сервера",
        "type": "field",
        "ip": ["geoip:private"],
        "outboundTag": "BLOCK"
      },
      {
        "_comment": "BitTorrent: иначе хостер пришлёт abuse и отключит сервер",
        "type": "field",
        "protocol": ["bittorrent"],
        "outboundTag": "BLOCK"
      },
      {
        "_comment": "Реклама и трекеры",
        "type": "field",
        "domain": ["geosite:category-ads-all"],
        "outboundTag": "BLOCK"
      }
    ]
  },
  "policy": {
    "levels": {
      "0": {
        "handshake": 4,
        "connIdle": 300,
        "uplinkOnly": 2,
        "downlinkOnly": 5,
        "statsUserUplink": true,
        "statsUserDownlink": true
      }
    },
    "system": {
      "statsInboundUplink": true,
      "statsInboundDownlink": true
    }
  },
  "stats": {}
}
