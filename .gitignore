# ── Логи и системные файлы ──────────────────────────────────────────────
*.log
logs/
.DS_Store
Thumbs.db

# ── Переменные окружения и секреты (КРИТИЧНО: никогда не коммитим!) ─────
.env
.env.*
!.env.example
*.env.local

# ── Секреты VPN (КРИТИЧНО!) ─────────────────────────────────────────────
*.key
*.crt
*.pem
*.ovpn
config/live/
# Ключи Reality и собранный конфиг Xray.
# Комментарий отдельной строкой: git считает комментарием только строку,
# начинающуюся с #, а в конце шаблона он стал бы частью самого шаблона —
# правило перестало бы совпадать, и приватные ключи попали бы в репозиторий.
config/generated/
config/**/*.private.json
xray_keys.txt
reality_keys.txt

# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

