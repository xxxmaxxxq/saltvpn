# ═══════════════════════════════════════════════════════════════════════════
#  VPN SERVICE — шаблон переменных окружения
#  Скопируйте файл:  cp .env.example .env   и заполните значения.
#  ВНИМАНИЕ: файл .env в git НЕ попадает (см. .gitignore). Это правильно.
# ═══════════════════════════════════════════════════════════════════════════

# ── 0. ЛОКАЛЬНЫЙ ЗАПУСК (посмотреть интерфейс бота на своём компьютере) ────
# true  = база в файле SQLite, состояния в памяти: Postgres, Redis, Marzban
#         и домен НЕ нужны. Интерфейс работает, ключи VPN не выдаются.
# false = боевой режим (Postgres + Redis + Marzban), см. docs/RUNBOOK.md
LOCAL_MODE=false
SQLITE_PATH=vpn_local.sqlite3

# ── 1. ОБЩИЕ НАСТРОЙКИ ─────────────────────────────────────────────────────
ENV=development                       # development | production
LOG_LEVEL=INFO                        # DEBUG на время отладки, INFO на проде
TZ=Europe/Moscow                      # часовой пояс для уведомлений и cron

# Публичный домен, на котором висит API/Mini App (без слэша в конце).
# Нужен для: ссылки-подписки, Mini App, вебхуков платёжек.
PUBLIC_BASE_URL=https://vpn.example.com

# Название сервиса: видно в приложениях (Happ, Hiddify) вместо адреса сервера
SERVICE_NAME=SaltVPN

# Домен панели Marzban (отдельный субдомен, A-запись на тот же сервер)
PANEL_BASE_URL=https://panel.example.com

# ── 2. TELEGRAM ────────────────────────────────────────────────────────────
BOT_TOKEN=123456789:AA-your-token-from-BotFather
BOT_USERNAME=your_vpn_bot             # без @, нужен для реферальных ссылок
ADMIN_IDS=123456789                   # ваши Telegram ID через запятую
SUPPORT_USERNAME=your_support         # без @, кнопка "Поддержка"
BACKUP_BOT_USERNAME=your_vpn_bot2     # резервный бот на случай блокировки
NEWS_CHANNEL_URL=https://t.me/your_channel

# Секрет для вебхука Telegram (любая случайная строка 32+ символов).
TELEGRAM_WEBHOOK_SECRET=change_me_random_32_chars_min
# polling — для локальной разработки, webhook — для прода
BOT_MODE=polling

# ── 3. БАЗА ДАННЫХ ─────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=vpn_admin
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=vpn_service

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# ── 4. ПАНЕЛЬ MARZBAN ──────────────────────────────────────────────────────
# Внутренний адрес панели (в docker-compose это http://marzban:8000).
MARZBAN_BASE_URL=http://marzban:8080
MARZBAN_USERNAME=admin
MARZBAN_PASSWORD=change_me_marzban_password
# Домен, который отдаётся клиенту в ссылке-подписке.
MARZBAN_SUBSCRIPTION_URL=https://vpn.example.com

# ── 5. ПЛАТЕЖИ ─────────────────────────────────────────────────────────────
# ЮKassa — СБП для самозанятых. Основной способ оплаты.
# Где взять: кабинет ЮKassa → Интеграция → Ключи API.
# Там же задайте URL уведомлений: https://ваш-домен/webhook/yookassa
# и отметьте события payment.succeeded и payment.canceled.
YOOKASSA_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_URL=https://api.yookassa.ru/v3
# Почта для чека в ФНС. Пустая — чек придётся пробивать вручную
# в «Моём налоге» после каждой оплаты.
YOOKASSA_RECEIPT_EMAIL=

# Platega (СБП + карты МИР/Visa/MC)
PLATEGA_ENABLED=true
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET_KEY=
PLATEGA_API_URL=https://app.platega.io
PLATEGA_WEBHOOK_SECRET=change_me_platega_webhook_secret

# CryptoPay (@CryptoBot)
CRYPTOPAY_ENABLED=true
CRYPTOPAY_TOKEN=
CRYPTOPAY_API_URL=https://pay.crypt.bot/api
CRYPTOPAY_ASSET=USDT
# Курс рубля к доллару для конвертации (или 0 = тянуть из API CryptoBot)
CRYPTOPAY_USD_RATE=0

# Telegram Stars (оплата внутри Telegram, провайдер-токен не нужен)
STARS_ENABLED=true
STARS_RUB_PER_STAR=1.7                # сколько рублей стоит 1 звезда

# ── 5.1 РЕКВИЗИТЫ ДЛЯ САЙТА И ОФЕРТЫ ───────────────────────────────────────
# Без них ЮKassa не пропустит сайт на модерации: она проверяет ФИО и ИНН
# самозанятого и способ связи. Это персональные данные — они живут только
# здесь, в репозиторий не попадают.
OWNER_FULL_NAME=
OWNER_INN=
OWNER_EMAIL=
OWNER_PHONE=              # необязательно
OWNER_ADDRESS=            # необязательно

# ── 6. БЕЗОПАСНОСТЬ ────────────────────────────────────────────────────────
JWT_SECRET=change_me_super_secret_jwt_key
API_INTERNAL_TOKEN=change_me_internal_token   # для admin-panel -> api-server

# ── 7. AUTO-HEALING (мониторинг нод) ───────────────────────────────────────
HEALTH_CHECK_INTERVAL_SEC=120         # как часто проверяем ноды
HEALTH_FAIL_THRESHOLD=3               # сколько провалов подряд = нода "мертва"
HEALTH_TIMEOUT_SEC=5                  # таймаут TCP-проверки
HEALING_ENABLED=true                  # false = только уведомлять админа

# ── 8. БЭКАПЫ ──────────────────────────────────────────────────────────────
BACKUP_ENABLED=false
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
